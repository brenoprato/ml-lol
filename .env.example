# Riot Games API Configuration
RIOT_API_KEY=RGAPI-your-api-key-here
DEFAULT_PLATFORM=BR1
DEFAULT_REGION=americas
TARGET_QUEUE_ID=420

# Rate Limiter Settings (Development key limits: 20 req/1s, 100 req/120s)
RATE_LIMIT_SHORT_MAX=18
RATE_LIMIT_SHORT_WINDOW_SEC=1.0
RATE_LIMIT_LONG_MAX=95
RATE_LIMIT_LONG_WINDOW_SEC=120.0
RATE_LIMIT_SAFETY_MARGIN=0.9

# Storage and Batch Settings
DATA_DIR=data
OUTPUT_FORMAT=parquet
BATCH_SIZE=50
MAX_MATCHES_PER_PLAYER=10
